generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ADMIN
  EDITOR
}
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum SubmissionStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(EDITOR)
  accounts      Account[]
  sessions      Session[]
  articles      Article[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ProgramCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Program {
  id                String        @id @default(uuid())
  title             String
  slug              String        @unique
  categoryId        String?
  category          ProgramCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDescription  String
  description       String
  heroImage         String?
  heroImageAlt      String?
  duration          String?
  location          String?
  participantCount  String?
  difficulty        String?
  activities        String?
  included          String?
  excluded          String?
  safety            String?
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ArticleCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id           String          @id @default(uuid())
  title        String
  slug         String          @unique
  excerpt      String
  content      String
  coverImage   String?
  coverImageAlt String?
  categoryId   String?
  category     ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId     String?
  author       User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String?
  status       ContentStatus   @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model GalleryCategory {
  id        String         @id @default(uuid())
  name      String         @unique
  slug      String         @unique
  images    GalleryImage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model GalleryImage {
  id          String          @id @default(uuid())
  title       String
  imageUrl    String
  alt         String
  caption     String?
  categoryId  String?
  category    GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      ContentStatus   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model TeamMember {
  id        String        @id @default(uuid())
  name      String
  role      String
  biography String
  photoUrl  String?
  photoAlt  String?
  sortOrder Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, sortOrder])
}

model ConservationProject {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  summary     String
  description String
  imageUrl    String?
  imageAlt    String?
  location    String?
  startedAt   DateTime?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, startedAt])
}

model ContactSubmission {
  id               String           @id @default(uuid())
  name             String
  email            String
  phone            String
  organization     String?
  programType      String?
  participantCount Int?
  plannedDate      DateTime?
  message          String
  status           SubmissionStatus @default(NEW)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([email, createdAt])
}

model ContactRateLimit {
  email           String   @id
  windowStartedAt BigInt
  count           Int

  @@index([windowStartedAt])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  operation  String
  entity     String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
